{
  "git": {
    "requireUpstream": false,
    "tagName": "v${version}",
    "commitMessage": "chore(release): ${name}@${version}",
    "requireCleanWorkingDir": false
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": true,
    "tokenRef":"process.env.GITHUB_TOKEN"
  },
  "hooks": {
    "after:bump": "node ./scripts/checkout-branch.js --version ${version}",
    "after:git:release":"node ./scripts/create-pull-request.js --verbose"
  }
}
